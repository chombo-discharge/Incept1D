# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Sphinx documentation (build products, including the generated figures)
Docs/_build/
Docs/build/
Docs/source/figures/

# Virtual environments
.venv/
venv/
env/

# Editor / IDE
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store

# pre-commit
.pre-commit-cache/

# Output data generated by the scripts (plots, tables)
*.png
*.pdf
!Docs/**/*.png
!Docs/**/*.pdf

# Misc
*.log
# Example outputs (regenerated by Examples/*/run.sh)
Examples/**/Sim*.dat
