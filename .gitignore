# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Sphinx documentation (build products, including the generated figures)
docs/_build/
docs/build/
docs/source/figures/

# Virtual environments
.venv/
venv/
env/

# Editor / IDE / assistant tooling
.vscode/
.idea/
*.swp
.serena/

# OS cruft
.DS_Store

# pytest
.pytest_cache/

# pre-commit
.pre-commit-cache/

# Output data generated by the scripts (plots, tables)
*.png
*.pdf
!docs/**/*.png
!docs/**/*.pdf

# Misc
*.log
# Example outputs (regenerated by examples/*/run.sh)
examples/**/sim*.dat
examples/paschen/closed_form.dat
examples/fieldline/line_*.csv

# Field-line exports dropped in the repository root while testing.  They are
# the user's own data, not ours to track or to license, and `reuse lint`
# skips whatever git ignores.
/*.csv
/*.dat
