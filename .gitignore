# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Sphinx documentation (build products, including the generated figures)
docs/_build/
docs/build/
docs/source/figures/

# Virtual environments
.venv/
venv/
env/

# Editor / IDE / assistant tooling
.vscode/
.idea/
*.swp
.serena/

# OS cruft
.DS_Store

# pytest
.pytest_cache/

# pre-commit
.pre-commit-cache/

# Output data generated by the scripts (plots, tables)
*.png
*.pdf
!docs/**/*.png
!docs/**/*.pdf

# Misc
*.log
# Example outputs (regenerated by examples/*/run.sh)
examples/**/sim*.dat
examples/paschen/closed_form.dat
examples/fieldline/line_*.csv

# Third-party reference tables: copyrighted by the IEC and by CIGRE, so they
# are NOT part of this repository.  Users who hold a copy drop it in the
# example directory to enable the comparison overlay -- see the READMEs there.
examples/iec60052/iec60052_*.dat
examples/electra/tablec2_air.dat
