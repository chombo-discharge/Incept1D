{
    "format": "incept1d-mechanism/1",
    "description": "Air with the Bloch-Bradbury attachment and O3- formation as two-body steps through explicit excited ions O2-(exc) and O3-*: electrons, N2+, O2+, O-, O2-(exc), O2-, O3-*, O3-, with electron transport and rates from BOLSIG+ and two-stream photoionization fitted to the Zheleznyak absorption curve.  See docs/source/configuration/examples/air.rst.",

    "parameters": {
        "cross_sections": "../lxcat/phelps.txt",
        "_cross_sections": "BOLSIG+ output with the electron transport and rate coefficients",
        "x_n2": 0.79,
        "x_o2": 0.21,
        "_x_n2": "Mole fractions; must match the mixture the cross_sections table was computed for, when it records one",
        "gamma0": 1e-6,
        "gamma1": 0.0,
        "eref": 170e7,
        "beta": 1.0,
        "_gamma0": "Ion-induced yield gamma0 + gamma1 exp(-eref/(beta E)), eref in V/m",
        "ngroups": 3,
        "cone_angle": 45.0,
        "_cone_angle": "Half-opening angle [deg] of the emission cone; its solid-angle fraction (1 - cos)/2 scales the photon source",
        "xi_photo": 1.0,
        "_xi_photo": "Multiplier on the photoionization coupling",
        "xi_emit": 1.0,
        "_xi_emit": "Multiplier on the photoemission yield"
    },

    "gas": {"N2": "x_n2", "O2": "x_o2"},

    "tables": {
        "bolsig": {
            "format": "bolsig+",
            "file": "cross_sections",
            "columns": {"mean_energy": "A1", "mu_e_N": "A2"},
            "rates": {
                "k_ion_N2": "N2 Ionization",
                "k_ion_O2": "O2 Ionization",
                "k_att_O2": "O2 Attachment"
            }
        },
        "o2m": {"format": "lxcat", "file": "../lxcat/o2m_mobility.txt", "columns": {"K0_O2m": 1}},
        "o3m": {"format": "lxcat", "file": "../lxcat/o3m_mobility.txt", "columns": {"K0_O3m": 1}}
    },

    "untracked": ["O"],

    "definitions": {
        "Te": "2*mean_energy*qe/(3*kB)",
        "_Te": "Electron temperature [K] from the mean energy, Maxwellian",
        "v_e": "mu_e_N*EN*1e-21",
        "N_loschmidt": "2.6868e25",
        "mu_cation_N": "2e-4*1e5/(kB*300)",
        "_mu_cation_N": "N2+ and O2+: 2 cm^2/(V s) at 1 bar, 300 K",
        "k_3b_O2": "1.4e-29*(300/Te)*exp(-600/T)*exp(700*(Te - T)/(Te*T))*1e-12",
        "_k_3b_O2": "Three-body attachment e + O2 + O2 [m^6/s], Kossyi et al.",
        "k_autodetach_O2m": "1e10",
        "k_quench_O2m": "1e-15",
        "_k_quench_O2m": "O2-(exc) + O2 -> O2- + O2 [m^3/s]",
        "k_att_O2m": "k_3b_O2*k_autodetach_O2m/k_quench_O2m",
        "_k_att_O2m": "e + O2 -> O2-(exc) [m^3/s]: the three-body rate in the quasi-steady state of O2-(exc)",
        "k_autodetach_O3m": "1e10",
        "k_quench_O3m": "1e-15",
        "k_form_O3m": "1.1e-42*exp(-(EN/65)**2)*k_autodetach_O3m/k_quench_O3m",
        "_k_form_O3m": "O- + O2 -> O3-* [m^3/s]: O- + O2 + M -> O3- + M in the quasi-steady state of O3-*",
        "pq": "30/750.064",
        "_pq": "Quenching pressure [bar], 30 Torr"
    },

    "alpha": "(k_ion_N2*x_N2 + k_ion_O2*x_O2)*N/v_e",
    "eta": "(k_att_O2 + k_att_O2m)*x_O2*N/v_e",
    "_eta": "Every e + O2 -> O2-(exc) counts as a loss, as if O2-(exc) did not autodetach",

    "species": [
        {"name": "e",        "charge": -1, "mobility": "mu_e_N"},
        {"name": "N2+",      "charge":  1, "mobility": "mu_cation_N"},
        {"name": "O2+",      "charge":  1, "mobility": "mu_cation_N"},
        {"name": "O-",       "charge": -1, "mobility": "1.2e22"},
        {"name": "O2-(exc)", "charge": -1, "mobility": "K0_O2m*1e-4*N_loschmidt"},
        {"name": "O2-",      "charge": -1, "mobility": "K0_O2m*1e-4*N_loschmidt"},
        {"name": "O3-*",     "charge": -1, "mobility": "K0_O3m*1e-4*N_loschmidt"},
        {"name": "O3-",      "charge": -1, "mobility": "K0_O3m*1e-4*N_loschmidt"}
    ],

    "reactions": [
        {"reaction": "e + N2 -> 2e + N2+",         "rate": "k_ion_N2"},
        {"reaction": "e + O2 -> 2e + O2+",         "rate": "k_ion_O2"},
        {"reaction": "e + O2 -> O- + O",           "rate": "k_att_O2"},
        {"reaction": "e + O2 -> O2-(exc)",         "rate": "k_att_O2m"},
        {"reaction": "O2-(exc) -> e + O2",         "rate": "k_autodetach_O2m"},
        {"reaction": "O2-(exc) + O2 -> O2- + O2",  "rate": "k_quench_O2m"},
        {"reaction": "O2- + M -> e + O2 + M",      "rate": "1.24e-17*exp(-(179/(8.8 + EN))**2)"},
        {"reaction": "O- + O2 -> O + O2-",         "rate": "6.96e-17*exp(-(198/(5.6 + EN))**2)"},
        {"reaction": "O- + O2 -> O3-*",            "rate": "k_form_O3m"},
        {"reaction": "O3-* -> O- + O2",            "rate": "k_autodetach_O3m"},
        {"reaction": "O3-* + M -> O3- + M",        "rate": "k_quench_O3m"},
        {"reaction": "O3- + O2 -> O- + 2O2",       "rate": "0",
         "_rate": "Collisional detachment of O3-, disabled: 1e-18 exp(-1.5/eps) with the O3- mean energy eps [eV] was the candidate"}
    ],

    "photoionization": {
        "absorption": {"model": "zheleznyak", "groups": "ngroups", "absorber": "O2"},
        "source": {
            "reactions": ["e + N2 -> 2e + N2+", "e + O2 -> 2e + O2+"],
            "efficiency": "(1 - cos(cone_angle*pi/180))/2*0.6*pq/(p + pq)",
            "_efficiency": "Cone fraction x excitation efficiency 0.6 x quenching, per ionization"
        },
        "products": {"e": "0.1*xi_photo", "O2+": "0.1*xi_photo"},
        "cathode yield": "0.1*xi_emit"
    },

    "emission": {
        "ions": {
            "N2+": "gamma0 + gamma1*exp(-eref/(beta*E))",
            "O2+": "gamma0 + gamma1*exp(-eref/(beta*E))"
        }
    }
}
