[flake8]
# Compatible with black: https://black.readthedocs.io/en/stable/guides/using_black_with_other_tools.html
max-line-length = 88
extend-ignore =
    E203, E501, W503,
    # The codebase deliberately hand-aligns assignments/parameters/keywords
    # in places (e.g. `self._eref   = eref`); these are purely cosmetic and
    # are not part of the style black/flake8 disagree on above.
    E221, E251, E272, E127, E128
exclude =
    .git,
    __pycache__,
    build,
    Docs/build,
    Docs/build/*
